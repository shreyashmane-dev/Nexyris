# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Active partial downloads
downloads/*.part
downloads/*.info.json

# Heavy GGUF model binaries (stored locally on USB)
models/gguf/*.gguf
!models/gguf/.gitkeep

# Executable binaries (stored on USB)
bin/*.exe
bin/*.dll
bin/*.txt
!bin/.gitkeep
*.log
config/hosts/*.json

# Database journals and locks
data/database/*.db-journal
data/database/*.db-wal
data/database/*.db-shm
data/.heartbeat

# Temporary and scratch files
temp/*
!temp/.gitkeep
logs/*
!logs/.gitkeep
scratch/

# OS generated files
.DS_Store
Thumbs.db
